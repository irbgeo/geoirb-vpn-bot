# Split routing of VPN clients (deploy/geoirb-vpn.nft): marked client
# packets go to table 100 = the exit tunnel, and never fall back to the
# main table (fail closed: no tunnel, no foreign traffic). Runs before both
# tunnels and has no ExecStop, so the rule and the `unreachable` route stay
# across tunnel restarts. The `default dev awg-exit` route comes from the
# tunnel conf's PostUp and goes away with the interface. The bot's own ip
# rules (prio 100/101) belong to the bot's tunnel watcher, not to this unit.
[Unit]
Description=Split routing of VPN clients: Russian networks direct, the rest via awg-exit
Before=geoirb-awg0.service geoirb-awg-exit.service

[Service]
Type=oneshot
RemainAfterExit=yes
# reload (deploy) re-applies the same idempotent steps: a restart would also
# restart geoirb-awg0.service (Requires=) and drop every client
ExecStart=/opt/geoirb-vpn-bot/vpn-routes.sh
ExecReload=/opt/geoirb-vpn-bot/vpn-routes.sh

[Install]
WantedBy=multi-user.target

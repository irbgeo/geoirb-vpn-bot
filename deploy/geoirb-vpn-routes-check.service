# Every minute (geoirb-vpn-routes-check.timer): put the split-routing ip rule
# and the table-100 routes back if anything dropped them (networkd
# reconfiguring a link, a manual `netplan apply`). Without the rule, client traffic to foreign
# addresses leaves from the RU address. `rules` loads the nft table only when
# it is gone (an `nft flush ruleset`, a start of nftables.service).
[Unit]
Description=Re-assert the VPN split-routing rule and routes
After=geoirb-vpn-routes.service

[Service]
Type=oneshot
ExecStart=/opt/geoirb-vpn-bot/vpn-routes.sh rules
# One quiet run a minute: keep systemd's "Started/Finished" (info) out of the
# journal, but log what the script prints (it only prints when something is
# wrong) as a warning, so it passes the filter.
LogLevelMax=notice
SyslogLevel=warning

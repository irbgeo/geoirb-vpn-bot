[Unit]
Description=AmneziaWG tunnel from the RU entry server (exit side)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/awg-quick down /etc/geoirb-vpn/awg-exit.conf
ExecStart=/usr/bin/awg-quick up /etc/geoirb-vpn/awg-exit.conf
ExecStop=/usr/bin/awg-quick down /etc/geoirb-vpn/awg-exit.conf

[Install]
WantedBy=multi-user.target

[Unit]
Description=AmneziaWG server for VPN clients (awg0, UDP 443)
After=network-online.target
Wants=network-online.target
# No split routing = client traffic would leave unmarked from the RU IP.
# Ordered after it by the routes unit's Before=.
Requires=geoirb-vpn-routes.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The conf is the bot's (it adds and removes peers live with `awg syncconf`),
# and awg-quick runs its hook lines as root: the check refuses a conf that
# holds one. No `-` prefix: a failed check stops the start (and the stop,
# which then leaves the interface up).
ExecStartPre=/opt/geoirb-vpn-bot/awg0-check.sh /etc/amnezia/amneziawg/awg0.conf
ExecStartPre=-/usr/bin/awg-quick down /etc/amnezia/amneziawg/awg0.conf
ExecStart=/usr/bin/awg-quick up /etc/amnezia/amneziawg/awg0.conf
ExecStop=/opt/geoirb-vpn-bot/awg0-check.sh /etc/amnezia/amneziawg/awg0.conf
ExecStop=/usr/bin/awg-quick down /etc/amnezia/amneziawg/awg0.conf
# a failed start (the network not ready at boot) is tried again
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

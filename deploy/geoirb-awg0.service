[Unit]
Description=AmneziaWG server for VPN clients (awg0, UDP 443)
After=network-online.target
Wants=network-online.target
# No split routing = client traffic would leave unmarked from the RU IP.
# Ordered after it by the routes unit's Before=.
Requires=geoirb-vpn-routes.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The conf is the bot's (it adds and removes peers live with `awg syncconf`),
# and awg-quick runs its hook lines as root: awg0-run.sh gives awg-quick a
# root-only copy that it checked first (no hook lines), so the bot can't
# swap the file between the check and the run. A failed check stops the
# start (and the stop, which then leaves the interface up).
ExecStartPre=-/opt/geoirb-vpn-bot/awg0-run.sh down /etc/amnezia/amneziawg/awg0.conf
ExecStart=/opt/geoirb-vpn-bot/awg0-run.sh up /etc/amnezia/amneziawg/awg0.conf
ExecStop=/opt/geoirb-vpn-bot/awg0-run.sh down /etc/amnezia/amneziawg/awg0.conf
# a failed start (the network not ready at boot) is tried again
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

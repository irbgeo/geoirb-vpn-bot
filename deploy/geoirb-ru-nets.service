[Unit]
Description=Fill the nftables set of Russian networks (RIPE NCC delegated stats)
Wants=network-online.target
# the set lives in the table that geoirb-vpn-routes.service loads
After=network-online.target geoirb-vpn-routes.service

[Service]
Type=oneshot
ExecStart=/opt/geoirb-vpn-bot/ru-nets.sh
# A failed download (RIPE down, or no network yet when a missed weekly run
# starts right after boot: the timer is Persistent) is tried again in 10
# minutes, not in a week. The old set stays in use meanwhile.
Restart=on-failure
RestartSec=10min

[Unit]
Description=geoirb VPN Telegram bot (sells and manages AmneziaWG keys)
After=network-online.target geoirb-awg0.service geoirb-awg-exit.service
Wants=network-online.target

[Service]
User=vpnbot
Group=vpnbot
EnvironmentFile=/etc/geoirb-vpn-bot/env
ExecStart=/opt/geoirb-vpn-bot/bot
Restart=always
RestartSec=5
# Shutdown waits for in-flight payments, a broadcast and a maintenance run.
TimeoutStopSec=60

# Last-backup mark, maintenance flag, RU networks stamp.
StateDirectory=geoirb-vpn-bot

# NET_ADMIN only: `awg` changes awg0 live, `ip rule` sends the bot's own
# traffic through the exit tunnel (the tunnel watcher).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=strict
# awg0.conf, rewritten through .tmp/.bak files next to it
ReadWritePaths=/etc/amnezia/amneziawg
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target

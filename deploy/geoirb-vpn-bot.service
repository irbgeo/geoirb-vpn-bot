[Unit]
Description=geoirb VPN Telegram bot (sells and manages AmneziaWG keys)
After=network-online.target geoirb-awg0.service geoirb-awg-exit.service
Wants=network-online.target

[Service]
User=vpnbot
Group=vpnbot
EnvironmentFile=/etc/geoirb-vpn-bot/env
ExecStart=/opt/geoirb-vpn-bot/bot
Restart=always
RestartSec=5
# On stop the bot gives handlers in flight (payments) 15 s to finish, cuts a
# running broadcast (it reports what went out) and lets a running
# maintenance pass finish; its steps have their own limits, under this one.
TimeoutStopSec=60

# The bot's own files only: the maintenance flag. The last-backup mark and the
# RU networks stamp are root's, in /var/lib/geoirb-vpn; the bot only reads
# their time there (ProtectSystem=strict leaves /var/lib readable).
StateDirectory=geoirb-vpn-bot

# NET_ADMIN only: `awg` changes awg0 live, `ip rule` sends the bot's own
# traffic through the exit tunnel (the tunnel watcher).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=strict
# awg0.conf, rewritten through .tmp/.bak files next to it
ReadWritePaths=/etc/amnezia/amneziawg
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Less for a compromised bot to reach (audit 2026-10-26). Netlink stays:
# `awg` and `ip` change awg0 and the bot's routing rules through it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectProc=invisible
UMask=0077

[Install]
WantedBy=multi-user.target

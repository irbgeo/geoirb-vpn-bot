# Telegram bot token from @BotFather.
BOT_TOKEN=

# Telegram test environment (free Stars payments). Needs a bot made by @BotFather
# in a test account, with its own BOT_TOKEN. Never on the production server.
# TELEGRAM_TEST_ENV=true

# Mongo. On the server: the geoirb_vpn_bot user from ../server-infra/secret/database.yaml.
#   MONGO_URI=mongodb://geoirb_vpn_bot:<password>@127.0.0.1:27017/?authSource=geoirb_vpn
MONGO_URI=mongodb://localhost:27017
MONGO_DB=geoirb_vpn

# Encrypts client private keys in Mongo. 32 random bytes, base64:
#   openssl rand -base64 32
# Losing it makes stored keys unreadable. Back it up SEPARATELY from DB dumps.
DB_SECRET_KEY=

# Host in client configs (Endpoint = ENDPOINT_HOST:ListenPort). Prefer a domain.
ENDPOINT_HOST=

# Local only (deploy): this server's name in ../server-infra/secret/database.yaml.
# Not sent to the server. Default geoirb-vpn.
# INFRA_SERVER=geoirb-vpn

# Optional. Comments stay on their own lines: systemd's EnvironmentFile
# keeps a "# …" after a value as part of the value.
# SERVER_ID=geoirb-vpn
# DNS in client configs. On the RU server: unbound on awg0's address.
# CLIENT_DNS=10.8.0.1
# Client MTU (empty = not written). 1380 fits the GCP network (1460).
# CLIENT_MTU=1380
# Tariffs, days:stars (Telegram Stars).
# TARIFFS=30:150,90:400,365:1500
# Shown by /support, /paysupport, /terms.
# SUPPORT_CONTACT=@geoirb
# Free trial started by a user's first key.
# TRIAL_DAYS=7
# AmneziaWG server config on the host.
# AWG_CONF=/etc/amnezia/amneziawg/awg0.conf
# Limit for one awg / ip command.
# AWG_TIMEOUT=20s
# Local dev: scripts/dev-remote.sh (runs commands on the server over ssh).
# AWG_EXEC=
# Tunnel to the exit server; empty = no tunnel watch. Deploy sets awg-exit.
# EXIT_IFACE=awg-exit
# Touched by every good update of the RU networks list; empty = no check.
# Deploy sets /var/lib/geoirb-vpn-bot/ru-nets.stamp.
# RU_NETS_STAMP=
# Telegram file ID of the video "app split tunneling" (Android, Windows),
# shown as step 3 of getting a key. Send the video to the bot as an admin:
# it answers with the ID. Empty = no step 3.
# SPLIT_VIDEO_FILE_ID=

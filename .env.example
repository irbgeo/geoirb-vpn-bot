# Telegram bot token from @BotFather.
BOT_TOKEN=

# Telegram test environment (free Stars payments). Needs a bot made by @BotFather
# in a test account, with its own BOT_TOKEN. Never on the production server.
# TELEGRAM_TEST_ENV=true

# Mongo. On the server: the geoirb_vpn_bot user from ../server-infra/secret/database.yaml.
#   MONGO_URI=mongodb://geoirb_vpn_bot:<password>@127.0.0.1:27017/?authSource=geoirb_vpn
MONGO_URI=mongodb://localhost:27017
MONGO_DB=geoirb_vpn

# Encrypts client private keys in Mongo. 32 random bytes, base64:
#   openssl rand -base64 32
# Losing it makes stored keys unreadable. Back it up SEPARATELY from DB dumps.
DB_SECRET_KEY=

# Host in client configs (Endpoint = ENDPOINT_HOST:ListenPort). Prefer a domain.
ENDPOINT_HOST=

# Optional. Comments stay on their own lines: systemd's EnvironmentFile
# keeps a "# …" after a value as part of the value.
# SERVER_ID=geoirb-vpn
# CLIENT_DNS=1.1.1.1, 1.0.0.1
# Tariffs, days:stars (Telegram Stars).
# TARIFFS=30:150,90:400,365:1500
# Shown by /support, /paysupport, /terms.
# SUPPORT_CONTACT=@geoirb
# Free trial started by a user's first key.
# TRIAL_DAYS=7
# Empty = auto-detect via docker ps.
# AWG_CONTAINER=amnezia-awg2
# Local dev: scripts/dev-docker.sh.
# DOCKER_BIN=docker
# DOCKER_TIMEOUT=20s
